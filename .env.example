DATABASE_URL=admin.db
JWT_SECRET=dev-secret-change-me
JWT_TTL_HOURS=8
# How long a refresh token is valid before the user has to log in again.
JWT_REFRESH_TTL_DAYS=14
PORT=8080

# Bootstrap system admin, created on first start-up (or adopted if the email
# is already registered). Self-registered users get no roles; this account
# hands them out from the Users page. Change the password for anything real.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345

# Bind all interfaces so an iPhone on the same Wi-Fi can reach the wallet
# download URLs encoded in QR codes. Use 127.0.0.1 to keep it local-only.
HOST=0.0.0.0

# Apple Wallet signing material (see priv/README.md). The values must match
# the certificate; these are the defaults from vendor/applewallet.
WALLET_PASS_TYPE_ID=pass.tz.ticketevent.pass.sample
WALLET_TEAM_ID=29S6Z4Y4MS
WALLET_PRIV_DIR=priv
# Optional overrides:
# WALLET_BASE_URL=http://192.168.1.20:8080   # otherwise auto-detected LAN IP + PORT
# WALLET_ASSETS_DIR=                          # extra pass artwork, falls back to embedded icons
# WALLET_APNS_ENV=production                  # or "sandbox"

# ----------------------------------------------------------------------------
# Email — used for password reset and any transactional mail the gateway sends.
# All of these are optional; if SMTP is not configured the mailer logs to the
# console (and the password-reset endpoint will include a `dev_token` in its
# JSON response so a developer can copy it out and complete the flow manually).
#
#   SMTP_HOST            server hostname, e.g. mail.example.com (required to send)
#   SMTP_PORT            587 (starttls, default) or 465 (smtps)
#   SMTP_USERNAME        usually the full mailbox address
#   SMTP_PASSWORD        mailbox password
#   SMTP_FROM            "Name <addr@host>" — shown in the From header
#   SMTP_ENVELOPE_FROM   optional override used during SMTP AUTH (some hosts
#                        require the local part to match the username)
#   SMTP_TLS             starttls (default) | tls | none
#   PUBLIC_BASE_URL      base URL the email body links to (e.g. https://app.example.com)
# ----------------------------------------------------------------------------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM="TableTop Labs <no-reply@example.com>"
# SMTP_ENVELOPE_FROM=
# SMTP_TLS=starttls
# PUBLIC_BASE_URL=http://localhost:5173
